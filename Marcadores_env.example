# ==============================================================================
# ARCHIVO DE EJEMPLO DE CONFIGURACIÓN (.env)
# Copia este archivo como ".env" antes de arrancar si deseas configurar a mano.
# Si no existe, app.py lo generará automáticamente en el primer inicio.
# Puedes administrar estos parámetros ejecutando: python CLI_admin.py
# ==============================================================================

# --- CONTROL DEL SISTEMA ---
# Bandera de primer arranque ('true' indica que el sistema ya fue aprovisionado)
SISTEMA_INICIALIZADO='true'

# --- SEGURIDAD Y CRIPTOGRAFÍA ---
# Clave para cifrar sesiones y cookies web (Flask)
SECRET_KEY='tu_clave_secreta_hex_256_bits'

# Clave maestra para acceder a configuraciones críticas y borrado
MASTER_KEY='tu_master_key_hex_256_bits'

# Contraseña de acceso a la interfaz web (por defecto: cambiame)
APP_PASSWORD='cambiame'

# --- PREFERENCIAS DE INTERFAZ (UI) ---
# Mostrar iconos favicon obtenidos de sitios web ('true' o 'false')
MOSTRAR_FAVICONS='true'

# Abrir los enlaces en una pestaña nueva del navegador ('true' o 'false')
ABRIR_NUEVA_PESTANA='true'

# Activar la interfaz en modo oscuro ('true' o 'false')
MODO_OSCURO='true'

# --- ENTORNO DE RED Y SERVIDOR ---
# Modo depuración de Flask ('true' para desarrollo, 'false' para producción)
# IMPORTANTE: Requerido en 'true' para operar CLI_Chaos.py
FLASK_DEBUG='false'

# Registro detallado de peticiones HTTP en consola ('true' o 'false')
LOG_MODE='false'

# Puerto de enlace HTTP local (predeterminado: 5050)
PORT='5050'

# Interfaz de escucha ('127.0.0.1' solo PC local, '0.0.0.0' para red LAN)
HOST='127.0.0.1'